# Backend base URL (no trailing slash)
VITE_API_URL=https://aerospeak-be.onrender.com

# Firebase configuration (projectId is required by Analytics)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Google Analytics (optional): analytics runs only in production builds and after the visitor's consent
VITE_FIREBASE_MEASUREMENT_ID=

# Google One Tap Configuration (OAuth 2.0 Web Client ID)
VITE_GOOGLE_ONE_TAP_CLIENT_ID=
